import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class TicketPurchaseSecurityTest {

    private final TicketPurchaseService service = new TicketPurchaseService();

    @Test
    void test_compra_requiere_usuario_registrado() {
   
        User usuario = new User("ana@example.com", true); // registrado
        PurchaseRequest request = new PurchaseRequest("2025-12-10", 2, "regular", "tarjeta");

        PurchaseResponse response = service.purchaseTickets(usuario, request);

        assertTrue(response.isSuccessful(), "La compra debería ser válida para un usuario registrado");
        assertNotNull(response.getConfirmationCode(), "Debe generar un código de confirmación");
    }
}
